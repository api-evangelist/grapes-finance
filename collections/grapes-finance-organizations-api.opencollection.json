          },
          "docs": "List organizations"
        },
        {
          "info": {
            "name": "Create organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.demo.grapesfinance.com/organizations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create organization"
        }
      ]
    }
  ],
  "bundled": true
}